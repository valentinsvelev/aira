# AIRA configuration
#
# Copy this file to .env and adjust it. Docker Compose reads .env automatically,
# and the API loads it too when you run it directly with Python.
# Every setting is optional: the defaults run AIRA fully locally with Ollama.
# Lines starting with # show the default value. Never commit your real .env.


# ---------------------------------------------------------------------------
# Database (Docker)
# ---------------------------------------------------------------------------

# Password for the bundled PostgreSQL container. Use a unique value with
# 12+ letters and digits (it is embedded in a connection URL). Changing it
# later does not change the password of an existing database volume.
POSTGRES_PASSWORD=

# POSTGRES_USER=aira
# POSTGRES_DB=aira

# Docker project name. It is also the prefix of the data volumes
# (aira_postgres_data, aira_huggingface_cache, ...).
# COMPOSE_PROJECT_NAME=aira


# ---------------------------------------------------------------------------
# Running the API without Docker
# ---------------------------------------------------------------------------

# SQLAlchemy database URL. The default is a SQLite file in .data/.
# For a local PostgreSQL with pgvector use for example:
# postgresql+psycopg://aira:<password>@localhost:5432/aira
# DATABASE_URL=sqlite:///./.data/aira.db

# Folder with your PDFs. Docker always mounts ./papers.
# PAPERS_DIR=papers

# Folder for evaluation runs and benchmark results.
# AIRA_DATA_DIR=.data

# Ollama address when the API runs directly on your machine.
# OLLAMA_BASE_URL=http://127.0.0.1:11434


# ---------------------------------------------------------------------------
# Language models
# ---------------------------------------------------------------------------

# ollama (local, default) or openai (hosted, needs OPENAI_API_KEY).
# LLM_PROVIDER=ollama

# Default local model. Install it first: ollama pull qwen3.5:4b
OLLAMA_MODEL=qwen3.5:4b

# Ollama address as seen from the API container. The default reaches Ollama
# running natively on your machine. With the cpu-ollama Compose profile use
# http://ollama:11434 instead.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Hosted alternative, only used with LLM_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Short chat titles, generated by a small local model after the first answer.
CHAT_TITLES_ENABLED=true
OLLAMA_TITLE_MODEL=qwen3.5:0.8b


# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------

# sparse (BM25), dense (embeddings) or hybrid (both, fused with RRF).
# RETRIEVAL_MODE=sparse

# Embedding model for dense and hybrid retrieval. The other supported model
# is Alibaba-NLP/gte-large-en-v1.5 (1024 dimensions, larger download).
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional reranker service (scripts/serve-reranker.sh), as seen from the API.
# The service itself reads RERANKER_DEVICE (auto, cpu, mps or cuda) and
# RERANKER_MAX_LENGTH from the shell it is started in.
# RERANKER_BASE_URL=http://host.docker.internal:8010
# RERANKER_TIMEOUT_SECONDS=300


# ---------------------------------------------------------------------------
# Note verification
# ---------------------------------------------------------------------------

# How saved notes are checked against their source passages:
#   semantic   - embedding similarity plus exact-quote and number checks
#   extractive - exact quotes only
#   tev1       - experimental TEV1 classifier served by Ollama
# FAITHFULNESS_MODE=semantic
# SIMILARITY_THRESHOLD=0.78
# TEV1_MODEL=tev1:0.8b
# TEV1_SUPPORTED_PROBABILITY=0.75


# ---------------------------------------------------------------------------
# Web and academic search
# ---------------------------------------------------------------------------

# ddgs (free, no key), tavily (needs TAVILY_API_KEY) or disabled.
# WEB_SEARCH_PROVIDER=ddgs
# WEB_SEARCH_MAX_RESULTS=4
# TAVILY_API_KEY=

# Optional free OpenAlex key for higher rate limits.
# OPENALEX_API_KEY=


# ---------------------------------------------------------------------------
# Paper Explorer models (optional, served by vLLM on a GPU machine)
# ---------------------------------------------------------------------------

# SCHOLAR_VLLM_DR_TULU_URL=http://host.docker.internal:8001/v1
# SCHOLAR_VLLM_ASTA_URL=http://host.docker.internal:8002/v1
# SCHOLAR_VLLM_API_KEY=


# ---------------------------------------------------------------------------
# Tracing with Phoenix (optional, stays on your machine)
# ---------------------------------------------------------------------------

# Export traces to the local Phoenix container (start it with: make tracing-up).
OTEL_TRACES_ENABLED=false

# Also store prompts, answers and source excerpts in traces. Keep this off
# unless you need to inspect them.
OTEL_CAPTURE_CONTENT=false

# PHOENIX_PROJECT_NAME=aira


# ---------------------------------------------------------------------------
# Optional Airflow ingestion (compose.airflow.yml)
# ---------------------------------------------------------------------------

# Cron schedule for the ingestion DAG. Empty means manual runs only.
# AIRA_INGEST_SCHEDULE=
